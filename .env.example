# Local development environment — template.
# Copy to .env.local (gitignored). Nothing here is secret; the site needs no
# keys to run locally.
#
# ⚠️ Two rules, both from real production outages in the project this setup is
# modelled on:
#   1. NEVER put LOCAL_DB_PATH in .env / .env.local / .env.production.
#      OpenNext bakes every value from those files into the deployed Worker, and
#      a baked LOCAL_DB_PATH makes production use local SQLite (every DB call
#      500s while pages still return 200). Set it on the command line instead:
#        LOCAL_DB_PATH=./other.db pnpm dev
#      `pnpm dev` already defaults to ./local.db without it.
#   2. NEVER put secrets in these files, for the same baking reason. Runtime
#      secrets go to the Worker via `pnpm secrets:push`, read with readRuntimeEnv().

# Opt out of Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
