# Production credentials — template.
# Copy to .env.prod (gitignored, never committed) and fill in. Read ONLY by the
# scripts in scripts/ (cf:setup, db:*:remote, secrets:push, deploy:prod) — Next
# never loads this file, so nothing here is baked into the site bundle.

# One account-wide Cloudflare API token. It is the only credential the project
# needs: it creates the D1 database and R2 bucket (pnpm cf:setup), applies
# migrations/seeds, pushes secrets and deploys the Worker. If a narrower token is
# ever wanted (e.g. CI read-only), create it with this one.
# Needed permissions: Workers Scripts:Edit, D1:Edit, Workers R2 Storage:Edit,
# Account Settings:Read (plus Zone/DNS edit later, when a custom domain is added).
# R2 is accessed through the Worker binding, so NO R2 S3 access keys are needed.
CLOUDFLARE_API_TOKEN=

# The Cloudflare account id (dashboard → Workers & Pages → right sidebar).
CLOUDFLARE_ACCOUNT_ID=

# Public URL the post-deploy smoke checks, no trailing slash. Until a domain is
# chosen: https://portfolio-2026.<your-subdomain>.workers.dev
SITE_URL=

# Secret that keys the anonymous visitor hash (HMAC-SHA256), at least 16
# characters. Pushed to the Worker by `pnpm secrets:push`. Generate with
# `openssl rand -hex 32`. Production answers 503 on /api/visit and /api/poll
# without it. Do not change it casually: that would re-count every visitor.
VISITOR_SALT=
