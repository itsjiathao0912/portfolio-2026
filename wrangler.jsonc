{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-2026",
  // A thin wrapper around OpenNext's generated Worker (.open-next/worker.js).
  // Workers Free caps CPU at 10 ms per request and entering OpenNext alone costs
  // more, so the wrapper answers cacheable GETs from caches.default (keyed by the
  // version id below) and only imports OpenNext on a miss. See worker-entry.mjs.
  "main": "worker-entry.mjs",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      // Written by `pnpm cf:setup` (scripts/cf-setup.mjs) after it creates the
      // database. Do not hand-edit unless you know the real id.
      "database_id": "5ddbd1c6-6366-484c-832c-2bf0cdb8ec98"
    }
  ],
  "r2_buckets": [
    {
      // Accessed through the binding only — no S3 API keys anywhere.
      "binding": "MEDIA",
      "bucket_name": "portfolio-media"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "itsjiathao.com", "custom_domain": true },
    { "pattern": "www.itsjiathao.com", "custom_domain": true }
  ]
}
