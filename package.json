{
  "name": "portfolio-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=${NEXT_DIST_DIR:-.next-dev} next dev",
    "build": "next build",
    "build:cf": "npx opennextjs-cloudflare build && node scripts/emit-prerender-assets.mjs",
    "start": "next start",
    "deploy": "echo 'Use `pnpm run deploy:prod` (bare `pnpm deploy` is a pnpm built-in and never runs this script).' && exit 1",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "cf:setup": "node scripts/cf-setup.mjs",
    "secrets:push": "node scripts/push-prod-secrets.mjs",
    "lint": "eslint",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:tests",
    "typecheck:app": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "bun test ./tests/unit",
    "test:e2e:isolated": "node scripts/run-isolated-e2e.mjs",
    "test:e2e:install": "playwright install chromium",
    "db:migrate:local": "node scripts/db-migrate.mjs --local",
    "db:migrate:remote": "node scripts/db-migrate.mjs --remote",
    "db:seed:local": "node scripts/seed.mjs --local",
    "db:seed:remote": "node scripts/seed.mjs --remote",
    "ui-add": "pnpm dlx shadcn@latest add",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@opennextjs/cloudflare": "^1.19.4",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.9.0",
    "motion": "^13.2.0",
    "next": "16.2.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260423.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "bun-types": "^1.3.14",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.84.1"
  }
}
